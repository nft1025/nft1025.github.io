# Optional: bake in a shared OpenRouter key at build time so every visitor
# can chat without pasting their own key. WARNING: this ends up in the
# public static bundle deployed to GitHub Pages, so anyone can extract and
# use it against your OpenRouter quota. Only do this with a free-tier key
# you're fine sharing, or leave it unset so each visitor supplies their own
# (stored only in their browser, never committed to the repo).
NEXT_PUBLIC_OPENROUTER_API_KEY=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

# Which OpenRouter model to use. Free-tier models rotate — check
# https://openrouter.ai/models?order=top-weekly and filter by "Free" for a
# current :free model ID before deploying.
NEXT_PUBLIC_OPENROUTER_MODEL=google/gemma-4-26b-a4b-it:free

# Where the contact form's "Open in Gmail" button sends messages.
NEXT_PUBLIC_CONTACT_EMAIL=neilfrancisteresa22@gmail.com
